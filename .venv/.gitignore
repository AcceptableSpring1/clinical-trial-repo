class MessageState(TypedDict):
    messages: Annotated[list[AnyMessage], operator.add]
    sub_questions : list[str]
    results: Annotated[list[str], operator.add]

def decompose(state: dict):
    messages = state["messages"][-1].content 

    qsplit = messages.split('?', maxsplit = 1)

    return {
        "sub_questions": qsplit 
    }

def retrieve_a(state:dict):
    q_one = state["sub_questions"][0]

    return{
        "results": [q_one]
    }
def retrieve_b(state:dict):
    q_two = state["sub_questions"][1]

    return{
        "results": [q_two]
    }

agent_builder = StateGraph(MessageState)
agent_builder.add_node("decompose", decompose)
agent_builder.add_node("retrieve_a",retrieve_a)
agent_builder.add_node("retrieve_b", retrieve_b)

agent_builder.add_edge(START,"decompose")
agent_builder.add_edge("decompose","retrieve_a")
agent_builder.add_edge("decompose","retrieve_b")
agent_builder.add_edge("retrieve_a", END)
agent_builder.add_edge("retrieve_b", END)

agent = agent_builder.compile()
messages = [HumanMessage(content="Whats the weather like in SoCal? Whats a nice city in Socal?")]
messages = agent.invoke({"messages":messages})

for m in messages["results"]:
    print(m)
