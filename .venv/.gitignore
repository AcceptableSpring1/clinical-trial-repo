from langchain.chat_models import init_chat_model
from dotenv import load_dotenv
load_dotenv()

model = init_chat_model("gpt-4o-mini", temperature=0)



# Define tools

@tool
def square(a: int ) -> int:
    """Multiply `a` and `a`.

    Args:
        a: First int times itself
    """
    return a * a

def is_even(a: int ) -> int:
    """ IF NEEDED the answer from the square tool 
        gets inserted to see if its 
        even or odd

    Args:
        a: Answer of square tool
    """
    if a % 2 == 0:
        return True
    else:
        return False

# @tool
# def multiply(a: int, b: int) -> int:
#     """Multiply `a` and `b`.

