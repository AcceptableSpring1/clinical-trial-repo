load_dotenv()


client = OpenAI()
pc = Pinecone()
index = pc.Index(host="https://clinical-trial-test-two-4pv7yax.svc.aped-4627-b74a.pinecone.io")

model = init_chat_model("gpt-4o-mini", temperature=0)

class MessageState(TypedDict):
    messages: Annotated[list[AnyMessage], operator.add]
    sub_questions : list[str]
    results: Annotated[list[str], operator.add]
    synthesis: list[str]

def decompose(state: dict):
    messages = state["messages"][-1].content 

    qsplit = model.invoke(
        [
        SystemMessage(content= "When you receive whatever question you get, you are to determine how many parts there are. If a question has multiple parts than you are to break each one down into it own question and add it to the list. For example if I say 'When are leaving and how old are you?', thats 2 questions. Additionally, return each sub-question on a new line with nothing else. number each question"
                      
                      ), HumanMessage(content=messages)
    ]

    ) 

    qsplit = [q for q in qsplit.content.split('\n') if q.strip()]
    
    return {
        "sub_questions": qsplit
    }

def continue_decompose(state:dict):
     
    return [
         
        Send("retrieve", {"sub_questions": sq}) for sq in state["sub_questions"]
     ]

def retrieve(state:dict):

    pineresults=[]

    q_one = client.embeddings.create(input=state["sub_questions"], model="text-embedding-3-small").data[0].embedding 

    query_results = index.query(
        namespace="__default__",
        vector= q_one,
        top_k=3,
        include_metadata=True,
        include_values=False
    ) 
    
    for x in query_results["matches"]:
        pineresults.append(x["metadata"]["text"])

    
    return {
        "results": pineresults
    }

    

def synthesize(state:dict):
    combined = model.invoke(
        [
           SystemMessage(content= "You are going to recieve 1 or more questions. You are to make coherent response answering all of the questions you receive. "), HumanMessage(content= ' | '.join(state["results"]))
    ]
    )

    return{
        "synthesis":combined.content
    }

agent_builder = StateGraph(MessageState)
agent_builder.add_node("decompose", decompose)
agent_builder.add_node("retrieve",retrieve)
agent_builder.add_node("synthesize", synthesize)

agent_builder.add_edge(START,"decompose")
agent_builder.add_conditional_edges("decompose",continue_decompose, ["retrieve"])
agent_builder.add_edge("retrieve","synthesize")
agent_builder.add_edge("synthesize", END)

agent = agent_builder.compile()

# messages = agent.invoke({"messages":messages})

class ParentGraph(TypedDict):
    messagestwo: Annotated[list[AnyMessage], operator.add]
    final: list[str]

def parent_node(state:dict):
    otherdata = agent.invoke({"messages": state["messagestwo"]})

    return{
        "final": otherdata["synthesis"]
    }

agenttwo_builder = StateGraph(ParentGraph)
agenttwo_builder.add_node("parent_node",parent_node)
agenttwo_builder.add_edge(START, "parent_node")
agenttwo_builder.add_edge("parent_node", END)

agent_two = agenttwo_builder.compile()
messages = [HumanMessage(content="How many participants were in the study? Were there any adverse events?")]
messages = agent_two.invoke({"messagestwo": messages})

print(messages["final"])



